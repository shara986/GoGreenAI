# GoGreen AI - Root .gitignore

# ===========================
# Backend (Spring Boot / Java)
# ===========================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.settings/
backend/.classpath
backend/.project
*.class
*.jar
*.war
*.ear

# ===========================
# Frontend (React / Node)
# ===========================
frontend/node_modules/
frontend/build/
frontend/.env.local
frontend/.env.production

# ===========================
# IDE & OS
# ===========================
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log
